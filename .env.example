# Copy to `.env` and adjust. docker compose reads this file automatically.
# Values here are safe local-dev defaults EXCEPT the secrets marked "change in production".

# --- PostgreSQL ---
POSTGRES_USER=pcmarket
POSTGRES_PASSWORD=pcmarket
POSTGRES_DB=pcmarket
POSTGRES_PORT=5432

# --- Redis ---
REDIS_PORT=6379

# --- MinIO ---
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin
MINIO_PORT=9000
MINIO_CONSOLE_PORT=9001
MINIO_BUCKET=pcmarket-media

# --- JWT signing (REQUIRED; compose refuses to start without it) ---
# Must be at least 32 characters. Generate one with:  openssl rand -base64 48
# Rotating this invalidates every issued access token, so treat it as a real secret.
JWT_SIGNING_KEY=dev-only-signing-key-change-me-in-production-min-32-bytes
JWT_ISSUER=pcmarket
JWT_AUDIENCE=pcmarket-clients

# --- Hostnames Nginx routes on ---
# Chrome and Firefox resolve *.localhost to 127.0.0.1, so these work with no hosts-file edit.
STOREFRONT_HOST=localhost
ADMIN_HOST=admin.localhost
API_HOST=api.localhost

# Ports Nginx publishes on the host. 80/443 in production.
HTTP_PORT=8080
HTTPS_PORT=8443

# --- Application ---
ASPNETCORE_ENVIRONMENT=Production

# Auto-migrate when the API starts. Fine for a single instance; set false for a rolling deploy and run
#   docker compose run --rm migrate
# first, so instances cannot race applying the same migration.
DB_MIGRATE_ON_STARTUP=true

# Import the bundled demo catalog (idempotent). Set false for a real store.
DB_SEED_DEMO_CATALOG=true

# Public URLs, used for payment return links and the Telegram webhook registration.
# For the Telegram webhook PUBLIC_API_URL must be reachable from the internet over HTTPS — in dev
# that means the quick tunnel below, not api.localhost.
PUBLIC_STOREFRONT_URL=http://localhost:8080
PUBLIC_API_URL=http://api.localhost:8080

# --- Container images (GHCR in CI/production; the defaults build locally) ---
# IMAGE_REGISTRY=ghcr.io/<owner>/pcmarket
# IMAGE_TAG=latest

# --- Telegram bot (off unless Enabled=true and a token is supplied) ---
# Full setup, including webhook registration: docs/runbooks/telegram-bot.md
# The webhook needs a public HTTPS URL. Locally:
#   docker compose --profile dev up -d tunnel
#   docker compose logs tunnel | grep trycloudflare.com   # → PUBLIC_API_URL
# The secret must be [A-Za-z0-9_-] only — generate with `openssl rand -hex 32`, not base64.
# TELEGRAM_ENABLED=true
# TELEGRAM_BOT_TOKEN=123456:ABC-DEF...
# TELEGRAM_WEBHOOK_SECRET=change-me-long-random
# Chat receiving new-order alerts. That chat must have messaged the bot at least once —
# Telegram forbids a bot opening a conversation. Negative ids are groups/channels; a private
# manager group is the recommended target, since staff are then added and removed by group
# membership. Add the bot to the group and send /chatid there to read the id.
# TELEGRAM_ADMIN_CHAT_ID=-1001234567890
#
# Let customers link by TYPING a phone number. That number is unverified, so it costs an SMS OTP to
# confirm — the "share contact" button needs none. Keep this false until an SMS provider is funded.
# TELEGRAM_ALLOW_PHONE_ENTRY=true

# --- Seeding (optional overrides read by the API at startup) ---
# SEED_ADMIN_PHONE=+998900000000
# SEED_ADMIN_PASSWORD=Admin!23456
# SEED_CATALOG_PATH=/app/demo-catalog.json

# --- Backups (scripts/backup.sh) ---
# BACKUP_DIR=/var/backups/pcmarket
# BACKUP_RETENTION_DAYS=14
