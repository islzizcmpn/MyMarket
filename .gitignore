# .NET
bin/
obj/
[Dd]ebug/
[Rr]elease/
*.user
*.suo
.vs/
artifacts/

# Build results
[Bb]in/
[Oo]bj/
*.dll
*.pdb

# Rider / VS
.idea/
*.sln.iml

# Test results
[Tt]est[Rr]esult*/
coverage/
