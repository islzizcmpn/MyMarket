*.keystore
*.mobileprovision
*.p12
Platforms/Android/**/bin/
Platforms/iOS/**/bin/

# OS
.DS_Store
Thumbs.db

# Docker
**/docker-compose.override.yml

# EF (keep migrations, ignore local db)
*.db
*.db-shm
*.db-wal


# Local agent/editor tooling directories.
# NB: these patterns also match the bare `.claude` / `.cursor` directories, since `*` matches zero
# characters. `.github` is deliberately NOT ignored — it holds the CI and deploy workflows.
*.claude
*.cursor

# Agent prompt scratch, but keep the workflows that actually run in CI.
.github/prompts/
