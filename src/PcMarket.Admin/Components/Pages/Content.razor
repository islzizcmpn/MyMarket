@page "/content"
@inherits AdminPageBase

<PageTitle>@L["Content.PageTitle"]</PageTitle>
<div class="topbar"><h1>@L["Content.Title"]</h1></div>

@if (_loading) { <div class="spinner"></div> }
else
{
    @if (_error is not null) { <div class="alert alert--error">@_error</div> }

    <div class="grid" style="grid-template-columns: 1fr 340px;">
        <div class="card">
            <div class="pad"><h3>@L["Content.Banners"]</h3></div>
            <table class="table">
                <thead><tr><th>@L["Common.Title"]</th><th>@L["Common.Translated"]</th><th>@L["Common.Sort"]</th><th>@L["Common.Active"]</th><th></th></tr></thead>
                <tbody>
                    @foreach (var b in _banners)
                    {
                        <tr>
                            <td>@b.Title</td>
                            <td class="muted">@TranslatedLanguages(b.Translations)</td>
                            <td>@b.SortOrder</td>
                            <td>@(b.IsActive ? L["Common.Yes"] : L["Common.No"])</td>
                            <td class="page-actions">
                                <button class="btn btn--ghost btn--sm" @onclick="() => EditBanner(b)">@L["Common.Edit"]</button>
                                <button class="btn btn--danger btn--sm" @onclick="() => DeleteBanner(b.Id)">@L["Common.Delete"]</button>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
        <div class="card pad" style="height:fit-content;">
            <h3>@(_bannerId is null ? L["Content.AddBanner"] : L["Content.EditBanner"])</h3>
            <div class="field"><label>@L["Common.Title"] <span class="muted">· @L["Common.English"]</span></label><input @bind="_bTitle" /></div>
            <TranslationFields Field="Title" Label="@L["Common.Title"]" Values="_bTranslations" />
            <div class="field"><label>@L["Content.Subtitle"] <span class="muted">· @L["Common.English"]</span></label><input @bind="_bSubtitle" /></div>
            <TranslationFields Field="Subtitle" Label="@L["Content.Subtitle"]" Values="_bTranslations" />
            <p class="muted" style="font-size:.8rem; margin:-4px 0 12px;">
                @L["Common.TranslationFallback"]
            </p>
            <div class="field"><label>@L["Content.ImageUrl"]</label><input @bind="_bImage" /></div>
            <div class="field"><label>@L["Content.LinkUrl"]</label><input @bind="_bLink" placeholder="/catalog" /></div>
            <div class="row">
                <div class="field"><label>@L["Common.Sort"]</label><input type="number" @bind="_bSort" /></div>
                <div class="field"><label>@L["Common.Active"]</label><select @bind="_bActive"><option value="true">@L["Common.Yes"]</option><option value="false">@L["Common.No"]</option></select></div>
            </div>
            <div class="page-actions">
                <button class="btn btn--primary" @onclick="SaveBanner">@L["Common.Save"]</button>
                @if (_bannerId is not null) { <button class="btn btn--ghost" @onclick="ResetBanner">@L["Common.Cancel"]</button> }
            </div>
        </div>
    </div>

    <div class="grid" style="grid-template-columns: 1fr 340px; margin-top:18px;">
        <div class="card">
            <div class="pad"><h3>@L["Content.Blocks"]</h3></div>
            <table class="table">
                <thead><tr><th>@L["Content.Key"]</th><th>@L["Common.Title"]</th><th>@L["Common.Translated"]</th><th>@L["Common.Active"]</th><th></th></tr></thead>
                <tbody>
                    @foreach (var c in _blocks)
                    {
                        <tr>
                            <td><code>@c.Key</code></td>
                            <td>@c.Title</td>
                            <td class="muted">@TranslatedLanguages(c.Translations)</td>
                            <td>@(c.IsActive ? L["Common.Yes"] : L["Common.No"])</td>
                            <td class="page-actions">
                                <button class="btn btn--ghost btn--sm" @onclick="() => EditBlock(c)">@L["Common.Edit"]</button>
                                <button class="btn btn--danger btn--sm" @onclick="() => DeleteBlock(c.Id)">@L["Common.Delete"]</button>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
        <div class="card pad" style="height:fit-content;">
            <h3>@(_blockId is null ? L["Content.AddBlock"] : L["Content.EditBlock"])</h3>
            <div class="field"><label>@L["Content.Key"]</label><input @bind="_cKey" placeholder="home-intro" /></div>
            <div class="field"><label>@L["Common.Title"] <span class="muted">· @L["Common.English"]</span></label><input @bind="_cTitle" /></div>
            <TranslationFields Field="Title" Label="@L["Common.Title"]" Values="_cTranslations" />
            <div class="field"><label>@L["Content.Body"] <span class="muted">· @L["Common.English"]</span></label><textarea rows="4" @bind="_cBody"></textarea></div>
            <TranslationFields Field="Body" Label="@L["Content.Body"]" Values="_cTranslations" Multiline="true" />
            <p class="muted" style="font-size:.8rem; margin:-4px 0 12px;">
                @L["Common.TranslationFallback"]
            </p>
            <div class="field"><label>@L["Common.Active"]</label><select @bind="_cActive"><option value="true">@L["Common.Yes"]</option><option value="false">@L["Common.No"]</option></select></div>
            <div class="page-actions">
                <button class="btn btn--primary" @onclick="SaveBlock">@L["Common.Save"]</button>
                @if (_blockId is not null) { <button class="btn btn--ghost" @onclick="ResetBlock">@L["Common.Cancel"]</button> }
            </div>
        </div>
    </div>
}

@code {
    private IReadOnlyList<AdminBannerDto> _banners = [];
    private IReadOnlyList<AdminCmsBlockDto> _blocks = [];
    private bool _loading = true;
    private string? _error;

    private Guid? _bannerId;
    private string _bTitle = "", _bSubtitle = "", _bImage = "", _bLink = "";
    private int _bSort;
    private bool _bActive = true;
    private Dictionary<(string Field, string Culture), string> _bTranslations = [];

    private Guid? _blockId;
    private string _cKey = "", _cTitle = "", _cBody = "";
    private bool _cActive = true;
    private Dictionary<(string Field, string Culture), string> _cTranslations = [];

    protected override async Task OnInitializedAsync()
    {
        if (!await EnsureAuthedAsync()) return;
        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        _loading = true;
        try { _banners = await Api.ListBannersAsync(); _blocks = await Api.ListBlocksAsync(); }
        catch (ApiException ex) { _error = ex.Message; }
        _loading = false;
    }

    private void EditBanner(AdminBannerDto b)
    {
        _bannerId = b.Id; _bTitle = b.Title; _bSubtitle = b.Subtitle ?? ""; _bImage = b.ImageUrl;
        _bLink = b.LinkUrl ?? ""; _bSort = b.SortOrder; _bActive = b.IsActive;
        _bTranslations = b.Translations.ToDictionary(t => (t.Field, t.Culture), t => t.Value);
    }
    private void ResetBanner()
    {
        _bannerId = null; _bTitle = _bSubtitle = _bImage = _bLink = ""; _bSort = 0; _bActive = true;
        _bTranslations = [];
    }

    private async Task SaveBanner()
    {
        _error = null;
        try
        {
            var req = new SaveBannerRequest(_bTitle.Trim(), NullIfEmpty(_bSubtitle), _bImage.Trim(), NullIfEmpty(_bLink),
                _bSort, _bActive, ToList(_bTranslations));
            if (_bannerId is null) await Api.CreateBannerAsync(req); else await Api.UpdateBannerAsync(_bannerId.Value, req);
            ResetBanner();
            await LoadAsync();
        }
        catch (ApiException ex) { _error = ex.Message; }
    }

    private async Task DeleteBanner(Guid id)
    {
        try { await Api.DeleteBannerAsync(id); await LoadAsync(); } catch (ApiException ex) { _error = ex.Message; }
    }

    private void EditBlock(AdminCmsBlockDto c)
    {
        _blockId = c.Id; _cKey = c.Key; _cTitle = c.Title; _cBody = c.Body ?? ""; _cActive = c.IsActive;
        _cTranslations = c.Translations.ToDictionary(t => (t.Field, t.Culture), t => t.Value);
    }
    private void ResetBlock()
    {
        _blockId = null; _cKey = _cTitle = _cBody = ""; _cActive = true;
        _cTranslations = [];
    }

    private async Task SaveBlock()
    {
        _error = null;
        try
        {
            var req = new SaveCmsBlockRequest(_cKey.Trim(), _cTitle.Trim(), NullIfEmpty(_cBody), _cActive,
                ToList(_cTranslations));
            if (_blockId is null) await Api.CreateBlockAsync(req); else await Api.UpdateBlockAsync(_blockId.Value, req);
            ResetBlock();
            await LoadAsync();
        }
        catch (ApiException ex) { _error = ex.Message; }
    }

    private async Task DeleteBlock(Guid id)
    {
        try { await Api.DeleteBlockAsync(id); await LoadAsync(); } catch (ApiException ex) { _error = ex.Message; }
    }

    private static string? NullIfEmpty(string s) => string.IsNullOrWhiteSpace(s) ? null : s.Trim();

    private static List<TranslationDto> ToList(Dictionary<(string Field, string Culture), string> values) =>
        [.. values.Select(kv => new TranslationDto(kv.Key.Field, kv.Key.Culture, kv.Value))];

    /// <summary>Shows at a glance which languages a row has been translated into.</summary>
    private static string TranslatedLanguages(IReadOnlyList<TranslationDto> translations) =>
        translations.Count == 0
            ? "—"
            : string.Join(", ", translations.Select(t => t.Culture).Distinct().Order().Select(c => c.ToUpperInvariant()));
}
