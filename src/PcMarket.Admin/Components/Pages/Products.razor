@page "/products"
@inherits AdminPageBase

<PageTitle>@L["Products.PageTitle"]</PageTitle>

<div class="topbar">
    <h1>@L["Nav.Products"]</h1>
    <div class="page-actions">
        <input placeholder="@L["Common.SearchPlaceholder"]" @bind="_search" @bind:event="oninput" @onkeydown="OnKey" />
        <a class="btn btn--primary" href="/products/new">@L["Products.New"]</a>
    </div>
</div>

@if (_loading)
{
    <div class="spinner"></div>
}
else if (_result is null || _result.Items.Count == 0)
{
    <div class="card pad"><p class="muted">@L["Products.Empty"]</p></div>
}
else
{
    <div class="card">
        <table class="table">
            <thead><tr><th>@L["Common.Name"]</th><th>@L["Products.Category"]</th><th>@L["Products.Brand"]</th><th>@L["Products.From"]</th><th>@L["Products.Stock"]</th><th>@L["Common.Active"]</th><th></th></tr></thead>
            <tbody>
                @foreach (var p in _result.Items)
                {
                    <tr>
                        <td><a href="@($"/products/{p.Id}")">@p.Name</a></td>
                        <td>@p.CategoryName</td>
                        <td>@(p.BrandName ?? "—")</td>
                        <td>@Format.Money(L, p.PriceFrom)</td>
                        <td>@p.TotalStock</td>
                        <td>@(p.IsActive ? L["Common.Yes"] : L["Common.No"])</td>
                        <td><a class="btn btn--ghost btn--sm" href="@($"/products/{p.Id}")">@L["Common.Edit"]</a></td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
    @if (_result.TotalPages > 1)
    {
        <div class="page-actions" style="justify-content:center; margin-top:16px;">
            <button class="btn btn--ghost btn--sm" disabled="@(_page <= 1)" @onclick="() => Go(_page - 1)">@L["Common.Prev"]</button>
            <span class="muted">@L["Common.PageOf", _page, _result.TotalPages]</span>
            <button class="btn btn--ghost btn--sm" disabled="@(_page >= _result.TotalPages)" @onclick="() => Go(_page + 1)">@L["Common.Next"]</button>
        </div>
    }
}

@code {
    private PagedResult<AdminProductListItemDto>? _result;
    private bool _loading = true;
    private string _search = string.Empty;
    private int _page = 1;

    protected override async Task OnInitializedAsync()
    {
        if (!await EnsureAuthedAsync()) return;
        await LoadAsync();
    }

    private async Task OnKey(KeyboardEventArgs e)
    {
        if (e.Key == "Enter") { _page = 1; await LoadAsync(); }
    }

    private async Task Go(int page) { _page = page; await LoadAsync(); }

    private async Task LoadAsync()
    {
        _loading = true;
        try { _result = await Api.ListProductsAsync(_search, _page, 20); } catch { _result = null; }
        _loading = false;
    }
}
