@page "/login"
@inject AuthApiClient Auth
@inject UsersApiClient Users
@inject AdminSession Session
@inject SessionStore Store
@inject NavigationManager Nav
@inject IStringLocalizer<SharedResource> L

<PageTitle>@L["Login.PageTitle"]</PageTitle>

<div class="login-wrap">
    <div class="card pad login-card">
        <h2>PCMarket Admin</h2>
        <p class="muted">@L["Login.Subtitle"]</p>

        @if (_error is not null)
        {
            <div class="alert alert--error">@_error</div>
        }

        <div class="field">
            <label>@L["Common.Phone"]</label>
            <input placeholder="+998900000000" @bind="_phone" />
        </div>
        <div class="field">
            <label>@L["Common.Password"]</label>
            <input type="password" @bind="_password" @onkeydown="OnKey" />
        </div>
        <button class="btn btn--primary" style="width:100%;" disabled="@_busy" @onclick="SignIn">
            @(_busy ? L["Login.SigningIn"] : L["Login.SignIn"])
        </button>
    </div>
</div>

@code {
    private string _phone = "+998900000000";
    private string _password = string.Empty;
    private bool _busy;
    private string? _error;

    private async Task OnKey(KeyboardEventArgs e)
    {
        if (e.Key == "Enter") await SignIn();
    }

    private async Task SignIn()
    {
        _busy = true;
        _error = null;
        try
        {
            var tokens = await Auth.LoginAsync(new LoginRequest(_phone.Trim(), _password));
            if (!tokens.Roles.Contains("Admin") && !tokens.Roles.Contains("Manager"))
            {
                _error = L["Login.NoAccess"];
                return;
            }

            Session.SetAuth(tokens);
            await Store.SaveAsync(Session);

            if (await StoredLanguageAsync() is { } culture)
            {
                // Landing straight on "/" would keep the language of whoever used this browser last, so the
                // account's own choice is applied first — the redirect ends up on "/" either way.
                Nav.NavigateTo($"/set-language?culture={Uri.EscapeDataString(culture)}&redirect=%2F", forceLoad: true);
                return;
            }

            Nav.NavigateTo("/");
        }
        catch (ApiException ex)
        {
            _error = ex.Message;
        }
        finally
        {
            _busy = false;
        }
    }

    /// <summary>The language stored on the account, or null when it has none or already matches this browser —
    /// in both cases there is nothing worth a reload for.</summary>
    private async Task<string?> StoredLanguageAsync()
    {
        try
        {
            var profile = await Users.GetProfileAsync();
            if (profile?.Language is not { } stored || !SupportedCultures.IsSupported(stored))
            {
                return null;
            }

            var culture = SupportedCultures.Normalize(stored);
            return string.Equals(culture, CultureInfo.CurrentUICulture.TwoLetterISOLanguageName, StringComparison.OrdinalIgnoreCase)
                ? null
                : culture;
        }
        catch (ApiException)
        {
            return null;
        }
    }
}
