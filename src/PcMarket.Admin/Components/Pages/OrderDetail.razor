@page "/orders/{Id:guid}"
@inherits AdminPageBase

<PageTitle>@L["OrderDetail.PageTitle"]</PageTitle>
<div class="topbar">
    <h1>@L["OrderDetail.Title", _detail?.Order.Number ?? string.Empty]</h1>
    <a class="btn btn--ghost" href="/orders">@L["Common.Back"]</a>
</div>

@if (_loading) { <div class="spinner"></div> }
else if (_detail is null) { <div class="card pad"><p class="muted">@L["OrderDetail.NotFound"]</p></div> }
else
{
    @if (_error is not null) { <div class="alert alert--error">@_error</div> }

    <div class="grid" style="grid-template-columns: 1fr 340px;">
        <div class="card pad">
            <h3>@L["OrderDetail.Items"]</h3>
            <table class="table">
                <tbody>
                    @foreach (var item in _detail.Order.Items)
                    {
                        <tr><td>@item.Qty × @item.Name</td><td style="text-align:right;">@Format.Money(L, item.LineTotal)</td></tr>
                    }
                </tbody>
            </table>
            <h3 style="margin-top:18px;">@L["OrderDetail.History"]</h3>
            @foreach (var h in _detail.Order.History)
            {
                <div class="row" style="justify-content:space-between;">
                    <span class="muted">@h.ChangedAt.LocalDateTime.ToString("g")</span>
                    <span>@(h.FromStatus is { } from ? L.EnumName(from) : "—") → @L.EnumName(h.ToStatus) @(string.IsNullOrEmpty(h.ChangedBy) ? "" : $"({h.ChangedBy})")</span>
                </div>
            }
        </div>

        <aside class="grid" style="height:fit-content;">
            <div class="card pad">
                <h3>@L["Common.Status"]</h3>
                <p><span class="status status--@_detail.Order.Status.ToString().ToLower()">@L.EnumName(_detail.Order.Status)</span></p>
                <div class="field">
                    <label>@L["OrderDetail.AdvanceTo"]</label>
                    <select @bind="_target">
                        @foreach (var s in Enum.GetValues<OrderStatus>()) { <option value="@s">@L.EnumName(s)</option> }
                    </select>
                </div>
                <div class="page-actions">
                    <button class="btn btn--primary btn--sm" disabled="@_busy" @onclick="Advance">@L["OrderDetail.Advance"]</button>
                    <button class="btn btn--danger btn--sm" disabled="@_busy" @onclick="Refund">@L["OrderDetail.Refund"]</button>
                </div>
            </div>
            <div class="card pad">
                <h3>@L["Orders.Customer"]</h3>
                @if (_detail.Customer is { } c)
                {
                    <div class="row" style="justify-content:space-between;"><span class="muted">@L["Common.Phone"]</span><span>@c.Phone</span></div>
                    <div class="row" style="justify-content:space-between;"><span class="muted">@L["Common.Name"]</span><span>@(c.FullName ?? "—")</span></div>
                    <div class="row" style="justify-content:space-between;"><span class="muted">@L["OrderDetail.OrderCount"]</span><span>@c.OrderCount</span></div>
                }
                else { <p class="muted">@L["OrderDetail.Unknown"]</p> }
            </div>
            <div class="card pad">
                <h3>@L["OrderDetail.Delivery"]</h3>
                @{
                    var shipping = _detail.Order.ShippingAddress;
                    var written = string.Join(", ", new[] { shipping.Region, shipping.City, shipping.Street, shipping.Details }
                        .Where(part => !string.IsNullOrWhiteSpace(part)));
                }
                <div class="row" style="justify-content:space-between;"><span class="muted">@L["OrderDetail.Address"]</span><span>@(string.IsNullOrWhiteSpace(written) ? "—" : written)</span></div>
                @if (shipping is { Latitude: { } lat, Longitude: { } lon })
                {
                    <div class="row" style="justify-content:space-between;">
                        <span class="muted">@L["OrderDetail.Coordinates"]</span>
                        <span>@MapLinks.Coordinates(lat, lon)</span>
                    </div>
                    <div class="page-actions" style="margin-top:10px;">
                        <a class="btn btn--ghost btn--sm" href="@MapLinks.Google(lat, lon)" target="_blank" rel="noopener">@L["OrderDetail.OpenInGoogle"]</a>
                        <a class="btn btn--ghost btn--sm" href="@MapLinks.Yandex(lat, lon)" target="_blank" rel="noopener">@L["OrderDetail.OpenInYandex"]</a>
                    </div>
                }
                else
                {
                    <p class="muted" style="font-size:.8rem; margin:8px 0 0;">@L["OrderDetail.NoLocation"]</p>
                }
            </div>
            <div class="card pad">
                <h3>@L["Common.Payment"]</h3>
                <div class="row" style="justify-content:space-between;"><span class="muted">@L["OrderDetail.Method"]</span><span>@L.EnumName(_detail.Order.PaymentMethod)</span></div>
                <div class="row" style="justify-content:space-between;"><span class="muted">@L["Common.Status"]</span><span>@L.EnumName(_detail.Order.PaymentStatus)</span></div>
                <div class="row" style="justify-content:space-between;"><span class="muted">@L["Common.Total"]</span><span>@Format.Money(L, _detail.Order.Total)</span></div>
            </div>
        </aside>
    </div>
}

@code {
    [Parameter] public Guid Id { get; set; }

    private AdminOrderDetailDto? _detail;
    private bool _loading = true, _busy;
    private string? _error;
    private OrderStatus _target = OrderStatus.Processing;

    protected override async Task OnParametersSetAsync()
    {
        if (!await EnsureAuthedAsync()) return;
        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        _loading = true;
        try { _detail = await Api.GetOrderAsync(Id); } catch (ApiException ex) { _error = ex.Message; }
        _loading = false;
    }

    private async Task Advance()
    {
        _busy = true; _error = null;
        try { _detail = await Api.AdvanceOrderAsync(Id, _target); }
        catch (ApiException ex) { _error = ex.Message; }
        finally { _busy = false; }
    }

    private async Task Refund()
    {
        _busy = true; _error = null;
        try { _detail = await Api.RefundOrderAsync(Id); }
        catch (ApiException ex) { _error = ex.Message; }
        finally { _busy = false; }
    }
}
