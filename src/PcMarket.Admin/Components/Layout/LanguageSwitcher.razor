@inject NavigationManager Nav
@inject UsersApiClient Users
@inject IStringLocalizer<SharedResource> L

<div class="lang-switch" role="group" aria-label="@L["Header.Language"]">
    @for (var i = 0; i < SupportedCultures.All.Length; i++)
    {
        var (code, label) = SupportedCultures.All[i];
        var isCurrent = string.Equals(code, _current, StringComparison.OrdinalIgnoreCase);

        if (i > 0)
        {
            <span class="lang-switch__sep" aria-hidden="true">|</span>
        }

        <button type="button"
                class="lang-switch__item @(isCurrent ? "is-active" : null)"
                aria-current="@(isCurrent ? "true" : null)"
                disabled="@isCurrent"
                @onclick="() => SwitchTo(code)">@label</button>
    }
</div>

@code {
    private string _current = SupportedCultures.Default;

    protected override void OnInitialized() =>
        _current = CultureInfo.CurrentUICulture.TwoLetterISOLanguageName;

    // The account is where the choice belongs, so it is saved from here — inside the circuit, which is the
    // only place the manager's access token exists. Culture itself is baked into the circuit when it
    // connects, so the new value can only take effect through a full browser navigation: hence forceLoad,
    // via /set-language, which writes the cookie the next request reads.
    private async Task SwitchTo(string code)
    {
        try
        {
            await Users.SetLanguageAsync(code);
        }
        catch (ApiException)
        {
            // A failed save must not trap the manager in a language they cannot read: the switch still
            // happens for this browser, it just will not follow them to another one.
        }

        var returnTo = "/" + Nav.ToBaseRelativePath(Nav.Uri);
        Nav.NavigateTo(
            $"/set-language?culture={Uri.EscapeDataString(code)}&redirect={Uri.EscapeDataString(returnTo)}",
            forceLoad: true);
    }
}
