@inherits LayoutComponentBase
@implements IDisposable
@inject AdminSession Session
@inject SessionStore Store
@inject NavigationManager Nav
@inject IStringLocalizer<SharedResource> L

@if (!_ready)
{
    <div class="spinner"></div>
}
else if (!Session.IsAuthenticated)
{
    @Body
}
else
{
    <div class="shell">
        <aside class="sidebar">
            <div class="brand">PC<span>Market</span> Admin</div>
            <NavLink class="navlink" href="/" Match="NavLinkMatch.All">📊 @L["Nav.Dashboard"]</NavLink>
            <NavLink class="navlink" href="/products">📦 @L["Nav.Products"]</NavLink>
            <NavLink class="navlink" href="/categories">🗂 @L["Nav.Categories"]</NavLink>
            <NavLink class="navlink" href="/brands">🏷 @L["Nav.Brands"]</NavLink>
            <NavLink class="navlink" href="/content">🖼 @L["Nav.Content"]</NavLink>
            <NavLink class="navlink" href="/orders">🧾 @L["Nav.Orders"]</NavLink>
            <NavLink class="navlink" href="/customers">👥 @L["Nav.Customers"]</NavLink>
            <NavLink class="navlink" href="/import">⬆ @L["Nav.Import"]</NavLink>
            <NavLink class="navlink" href="/audit">🔎 @L["Nav.Audit"]</NavLink>
            <a class="navlink signout" @onclick="SignOut" style="cursor:pointer;">🚪 @L["Nav.SignOut"]</a>
        </aside>
        <div class="main">
            <div class="topbar">
                <div></div>
                <div class="who">
                    <LanguageSwitcher />
                    <span>@L["Header.SignedIn", string.Join(", ", Session.Roles)]</span>
                </div>
            </div>
            @Body
        </div>
    </div>
}

<div id="blazor-error-ui" data-nosnippet>
    @L["App.Error"]
    <a href="." class="reload">@L["App.Reload"]</a>
    <span class="dismiss">🗙</span>
</div>

@code {
    private bool _ready;

    protected override async Task OnInitializedAsync()
    {
        Session.Changed += OnChanged;
        if (!Session.Loaded)
        {
            await Store.LoadIntoAsync(Session);
        }
        _ready = true;
    }

    private async Task SignOut()
    {
        await Store.ClearAsync(Session);
        Nav.NavigateTo("/login");
    }

    private void OnChanged() => InvokeAsync(StateHasChanged);

    public void Dispose() => Session.Changed -= OnChanged;
}
