@inherits LayoutComponentBase
@implements IDisposable
@inject AdminSession Session
@inject SessionStore Store
@inject NavigationManager Nav

@if (!_ready)
{
    <div class="spinner"></div>
}
else if (!Session.IsAuthenticated)
{
    @Body
}
else
{
    <div class="shell">
        <aside class="sidebar">
            <div class="brand">PC<span>Market</span> Admin</div>
            <NavLink class="navlink" href="/" Match="NavLinkMatch.All">📊 Dashboard</NavLink>
            <NavLink class="navlink" href="/products">📦 Products</NavLink>
            <NavLink class="navlink" href="/categories">🗂 Categories</NavLink>
            <NavLink class="navlink" href="/brands">🏷 Brands</NavLink>
            <NavLink class="navlink" href="/content">🖼 Content</NavLink>
            <NavLink class="navlink" href="/orders">🧾 Orders</NavLink>
            <NavLink class="navlink" href="/import">⬆ Import</NavLink>
            <NavLink class="navlink" href="/audit">🔎 Audit log</NavLink>
            <a class="navlink signout" @onclick="SignOut" style="cursor:pointer;">🚪 Sign out</a>
        </aside>
        <div class="main">
            <div class="topbar">
                <div></div>
                <div class="who">Signed in · @string.Join(", ", Session.Roles)</div>
            </div>
            @Body
        </div>
    </div>
}

<div id="blazor-error-ui" data-nosnippet>
    An unhandled error has occurred.
    <a href="." class="reload">Reload</a>
    <span class="dismiss">🗙</span>
</div>

@code {
    private bool _ready;

    protected override async Task OnInitializedAsync()
    {
        Session.Changed += OnChanged;
        if (!Session.Loaded)
        {
            await Store.LoadIntoAsync(Session);
        }
        _ready = true;
    }

    private async Task SignOut()
    {
        await Store.ClearAsync(Session);
        Nav.NavigateTo("/login");
    }

    private void OnChanged() => InvokeAsync(StateHasChanged);

    public void Dispose() => Session.Changed -= OnChanged;
}
