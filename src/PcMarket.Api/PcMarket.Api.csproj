<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <UserSecretsId>ca5d2a4c-3f05-466b-83dd-e4afd40a7341</UserSecretsId>
    <!--
      Overrides the solution-wide InvariantGlobalization=true from Directory.Build.props. Responses are
      localized per request (ru/uz/en) and invariant mode makes CultureInfo("ru") throw, which would break
      request localization at startup. Container images for this project must therefore ship ICU.
    -->
    <InvariantGlobalization>false</InvariantGlobalization>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.OpenApi" />
    <PackageReference Include="Microsoft.AspNetCore.Authentication.JwtBearer" />
    <PackageReference Include="Scalar.AspNetCore" />
    <PackageReference Include="Serilog.AspNetCore" />
    <PackageReference Include="Serilog.Sinks.Console" />
    <PackageReference Include="Hangfire.AspNetCore" />
    <PackageReference Include="Hangfire.PostgreSql" />
    <PackageReference Include="FluentValidation.DependencyInjectionExtensions" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\PcMarket.Infrastructure\PcMarket.Infrastructure.csproj" />
    <ProjectReference Include="..\PcMarket.Payments\PcMarket.Payments.csproj" />
    <ProjectReference Include="..\PcMarket.Bot\PcMarket.Bot.csproj" />
  </ItemGroup>

</Project>
