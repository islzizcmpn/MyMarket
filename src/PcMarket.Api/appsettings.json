{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "Postgres": "Host=localhost;Port=5432;Database=pcmarket;Username=pcmarket;Password=pcmarket"
  },
  "Redis": {
    "Configuration": "localhost:6379",
    "InstanceName": "pcmarket:"
  },
  "Minio": {
    "Endpoint": "localhost:9000",
    "AccessKey": "minioadmin",
    "SecretKey": "minioadmin",
    "Bucket": "pcmarket-media",
    "UseSsl": false
  },
  "Jwt": {
    "Issuer": "pcmarket",
    "Audience": "pcmarket-clients",
    "SigningKey": "dev-only-signing-key-change-me-in-production-min-32-bytes",
    "AccessTokenMinutes": 15,
    "RefreshTokenDays": 30
  },
  "Telegram": {
    "Enabled": false,
    "BotToken": "",
    "WebhookSecretToken": "",
    "AdminChatId": null,
    "StorefrontUrl": "http://localhost:5155",
    "PublicApiUrl": "",
    "PageSize": 6,
    "AllowPhoneEntry": false
  },
  "Payments": {
    "UnpaidOrderTimeoutMinutes": 30,
    "Click": {
      "Enabled": true,
      "ServiceId": "dev-click-service",
      "MerchantId": "dev-click-merchant",
      "SecretKey": "dev-click-secret-key",
      "CheckoutUrl": "https://my.click.uz/services/pay",
      "ReturnUrl": ""
    },
    "Payme": {
      "Enabled": true,
      "MerchantId": "dev-payme-merchant",
      "MerchantKey": "dev-payme-merchant-key",
      "CheckoutUrl": "https://checkout.paycom.uz"
    },
    "Cash": {
      "Enabled": true
    },
    "Uzcard": {
      "Enabled": true,
      "ServiceId": "dev-uzcard-service",
      "MerchantId": "dev-uzcard-merchant",
      "SecretKey": "dev-uzcard-secret-key",
      "CheckoutUrl": "https://my.click.uz/services/pay",
      "ReturnUrl": ""
    },
    "Humo": {
      "Enabled": true,
      "ServiceId": "dev-humo-service",
      "MerchantId": "dev-humo-merchant",
      "SecretKey": "dev-humo-secret-key",
      "CheckoutUrl": "https://my.click.uz/services/pay",
      "ReturnUrl": ""
    }
  }
}
