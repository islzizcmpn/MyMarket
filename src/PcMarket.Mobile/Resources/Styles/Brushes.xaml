<?xml version="1.0" encoding="UTF-8" ?>
<!--
    Gradient and glow brushes, ported from src/PcMarket.Web/wwwroot/app.css.

    Must be merged AFTER Colors.xaml: StaticResource resolves at parse time against the
    dictionaries merged so far, so a brush declared ahead of the colours it names fails at
    runtime, not at compile time.

    As in Colors.xaml, CSS custom properties are named without their leading double hyphen,
    because XML forbids a doubled hyphen inside a comment.

    THREE CONVERSIONS APPLY THROUGHOUT, because CSS gradients and XAML brushes do not map cleanly:

    1. `color-mix(in srgb, X n%, transparent)` has no XAML equivalent, so every mixed stop is
       precomputed to a literal ARGB. XAML writes alpha first: rgba(255,122,61,.30) becomes
       #4DFF7A3D. Each stop carries the source expression in a comment.

    2. CSS radial stops are percentages of the gradient's ending shape; MAUI GradientStop offsets
       are 0..1 along RadialGradientBrush.Radius. Each brush therefore sets Radius to the CSS
       ending percentage and rescales its stops by dividing through it — a CSS stop at 30% inside
       a 66% ending shape becomes offset 0.455. The falloff stays proportional.

    3. MAUI's RadialGradientBrush radius is a single scalar, so it is always circular. The CSS
       ellipses (hero bloom at 62% x 130%, the vignettes at 80% and 90% square) are approximated
       with a circle at the larger extent. The bloom loses its vertical stretch; it reads as a
       softer, rounder light rather than a column. This is the one visible fidelity loss in the
       port and there is no XAML mechanism that avoids it.

    Not ported here: the accent glow and lift shadows are box-shadows, not gradients. MAUI models
    a shadow as a single Shadow object and they need the shadow work in the motion layer.
-->
<ResourceDictionary
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml">

    <!-- ===================================================================================
         ACCENT GRADIENTS  (app.css tokens: grad-accent, grad-accent-hot)
         =================================================================================== -->

    <!-- app.css `grad-accent`: linear-gradient(135deg, ...). 135deg runs top-left to
         bottom-right, which is StartPoint 0,0 to EndPoint 1,1.

         This one carries white text, so its light end stops short of orange to hold 4.2:1. -->
    <LinearGradientBrush x:Key="BrushAccent" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Offset="0.0" Color="{AppThemeBinding Light=#9D1A14, Dark=#B5111D}" />
        <GradientStop Offset="1.0" Color="{AppThemeBinding Light=#C8451C, Dark=#D4431F}" />
    </LinearGradientBrush>

    <!-- app.css `grad-accent-hot`: linear-gradient(90deg, ...). 90deg runs left to right, which
         is StartPoint 0,0.5 to EndPoint 1,0.5.

         Runs all the way out to orange and is only ever used where no text sits on it: section
         rules, hairlines, glows. -->
    <LinearGradientBrush x:Key="BrushAccentHot" StartPoint="0,0.5" EndPoint="1,0.5">
        <GradientStop Offset="0.0" Color="{AppThemeBinding Light=#B5241A, Dark=#C1121F}" />
        <GradientStop Offset="1.0" Color="{AppThemeBinding Light=#E8752F, Dark=#FF7A3D}" />
    </LinearGradientBrush>

    <!-- ===================================================================================
         MEDIA GLOW  (app.css token: glow-media)

         Centred at 46% of card height — the lower edge of the square product image. Product
         photos are opaque, so a light centred behind the image would simply be hidden by it;
         sitting the core on the image's bottom edge lets the spill read across the card body
         instead, which is what makes the product look lit from behind.

         CSS ending shape 66%, so Radius=0.66 and the 30% stop rescales to 0.455.
         The light theme runs roughly half strength: a warm bloom that reads as light on charcoal
         reads as a stain on a bone page.
         =================================================================================== -->

    <RadialGradientBrush x:Key="BrushGlowMedia" Center="0.5,0.46" Radius="0.66">
        <!-- accent-hot at 30% dark / 16% light -->
        <GradientStop Offset="0.0" Color="{AppThemeBinding Light=#29E8752F, Dark=#4DFF7A3D}" />
        <!-- brand at 17% dark / 8% light -->
        <GradientStop Offset="0.455" Color="{AppThemeBinding Light=#14B5241A, Dark=#2BE0452E}" />
        <GradientStop Offset="1.0" Color="#00000000" />
    </RadialGradientBrush>

    <!-- ===================================================================================
         HERO BLOOM  (app.css token: hero-bloom)

         The hero's invisible studio light: an orange core falling off through red to nothing,
         wide enough that no edge of it is visible inside the frame.

         CSS is `ellipse 62% 130% at 24% 52%`; approximated as a circle at the larger extent
         (see conversion 3 above). CSS ending shape 68%, so the 36% stop rescales to 0.529.

         The hero art is a dark photograph in both themes, so the light values stay near the
         dark ones rather than following the page down.
         =================================================================================== -->

    <RadialGradientBrush x:Key="BrushHeroBloom" Center="0.24,0.52" Radius="0.68">
        <!-- accent-hot at 20% dark / 22% light -->
        <GradientStop Offset="0.0" Color="{AppThemeBinding Light=#38E8752F, Dark=#33FF7A3D}" />
        <!-- brand at 13% dark / 14% light -->
        <GradientStop Offset="0.529" Color="{AppThemeBinding Light=#24B5241A, Dark=#21E0452E}" />
        <GradientStop Offset="1.0" Color="#00000000" />
    </RadialGradientBrush>

    <!-- app.css `hero-vignette`: ellipse 90% 90% at 50% 50%, transparent 42% to a dark edge.
         Radius=0.9, so the 42% stop rescales to 0.467. -->
    <RadialGradientBrush x:Key="BrushHeroVignette" Center="0.5,0.5" Radius="0.9">
        <GradientStop Offset="0.467" Color="#00000000" />
        <!-- rgba(0,0,0,.5) dark / rgba(16,24,40,.38) light -->
        <GradientStop Offset="1.0" Color="{AppThemeBinding Light=#61101828, Dark=#80000000}" />
    </RadialGradientBrush>

    <!-- ===================================================================================
         MEDIA VIGNETTE  (app.css token: vignette-media)

         Two layers in CSS, both gentle: a wide corner falloff so the product is never on a flat
         plane, and a bottom fade that dissolves the image into the card body instead of ending
         on a hard edge. Kept light — anything stronger reads as a smudged lens rather than depth.

         A MAUI Brush paints one gradient, so the two layers ship as two brushes to be applied to
         stacked elements: Edge underneath, Fade over it. Applying only one is a valid reduction
         if the stack proves costly — Fade alone carries most of the effect.
         =================================================================================== -->

    <!-- CSS layer 1: linear-gradient(to bottom, transparent 60%, dark 100%). -->
    <LinearGradientBrush x:Key="BrushVignetteMediaFade" StartPoint="0.5,0" EndPoint="0.5,1">
        <GradientStop Offset="0.60" Color="#00000000" />
        <!-- rgba(0,0,0,.30) dark / rgba(16,24,40,.10) light -->
        <GradientStop Offset="1.0" Color="{AppThemeBinding Light=#1A101828, Dark=#4D000000}" />
    </LinearGradientBrush>

    <!-- CSS layer 2: radial ellipse 80% 80% at 50% 42%, transparent 52% to a dark edge.
         Radius=0.8, so the 52% stop rescales to 0.65 (dark) — the light theme starts its
         falloff later, at 55%, which rescales to 0.6875. Both use the dark theme's 0.65 so the
         brush keeps one stop geometry; the 3.5% difference is not perceptible at card size. -->
    <RadialGradientBrush x:Key="BrushVignetteMediaEdge" Center="0.5,0.42" Radius="0.8">
        <GradientStop Offset="0.65" Color="#00000000" />
        <!-- rgba(0,0,0,.26) dark / rgba(16,24,40,.10) light -->
        <GradientStop Offset="1.0" Color="{AppThemeBinding Light=#1A101828, Dark=#42000000}" />
    </RadialGradientBrush>

    <!-- ===================================================================================
         HERO PANEL  (app.css tokens: hero-from, hero-to)

         The flat fallback behind the hero, used when the remote banner has not loaded. Runs
         135deg like the accent gradient.
         =================================================================================== -->

    <LinearGradientBrush x:Key="BrushHeroPanel" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Offset="0.0" Color="{AppThemeBinding Light={StaticResource TokenHeroFromLight}, Dark={StaticResource TokenHeroFrom}}" />
        <GradientStop Offset="1.0" Color="{AppThemeBinding Light={StaticResource TokenHeroToLight}, Dark={StaticResource TokenHeroTo}}" />
    </LinearGradientBrush>

</ResourceDictionary>
