<?xml version="1.0" encoding="UTF-8" ?>
<!--
    Design tokens, ported from the storefront's system in src/PcMarket.Web/wwwroot/app.css.

    Two conventions to know before editing:

    1. CSS custom properties are named here WITHOUT their leading double hyphen — `bg`, not the
       CSS spelling. XML forbids a doubled hyphen inside a comment, so the CSS name cannot be
       written verbatim anywhere in this file.

    2. Each token is declared twice: `TokenX` carries the dark value (the default, as on the web)
       and `TokenXLight` carries the light one. XAML has no cascade to override, so consumers pair
       them explicitly:

           {AppThemeBinding Light={StaticResource TokenBgLight}, Dark={StaticResource TokenBg}}

       Views never reference a `*Light` key directly — it exists only to give the theme binding
       something to point at. The companion is declared even where both themes share a value, so
       consumers can bind uniformly without checking which tokens are theme-invariant.

    The stock MAUI template keys at the bottom are retuned in place rather than deleted: the
    untouched 434-line Styles.xaml binds to them, so redefining them carries the brand through every
    templated control without editing that file.

    Note: For Android see also Platforms\Android\Resources\values\colors.xml.
-->
<ResourceDictionary
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml">

    <!-- ===================================================================================
         SURFACES  (app.css tokens: bg, surface, surface-2, media-bg, input-bg)

         A graphite ramp where each step is ~3% lighter at the same faintly-cool hue, so the
         difference registers as elevation rather than as a second colour. The light theme takes
         the same warm-neutral turn — a bone page rather than a blue-grey one.
         =================================================================================== -->

    <Color x:Key="TokenBg">#101013</Color>
    <Color x:Key="TokenBgLight">#F5F4F2</Color>

    <Color x:Key="TokenSurface">#17171B</Color>
    <Color x:Key="TokenSurfaceLight">#FFFFFF</Color>

    <!-- The extra step the old two-tone ramp lacked: cards can sit on a panel without either
         dissolving into it. -->
    <Color x:Key="TokenSurface2">#1D1D22</Color>
    <Color x:Key="TokenSurface2Light">#FAF9F7</Color>

    <!-- Backdrop for product imagery. -->
    <Color x:Key="TokenMediaBg">#1B1B20</Color>
    <Color x:Key="TokenMediaBgLight">#EFEDEA</Color>

    <Color x:Key="TokenInputBg">#141418</Color>
    <Color x:Key="TokenInputBgLight">#FFFFFF</Color>

    <!-- ===================================================================================
         INK  (app.css tokens: ink, muted, line)
         =================================================================================== -->

    <Color x:Key="TokenInk">#F2F1EF</Color>
    <Color x:Key="TokenInkLight">#16161A</Color>

    <Color x:Key="TokenMuted">#8E8D97</Color>
    <Color x:Key="TokenMutedLight">#6C6B74</Color>

    <Color x:Key="TokenLine">#26262C</Color>
    <Color x:Key="TokenLineLight">#E5E3DF</Color>

    <!-- ===================================================================================
         BRAND  (app.css tokens: brand, brand-600, brand-700, brand-200, brand-050,
                 accent, accent-hot)

         Warm deep red: buttons, links, active nav, focus rings. The dark value is the warmest
         tone that still holds white button text (4.2:1) and stays legible as a link on charcoal
         (4.5:1) — pushing further into orange costs the button, pulling back into red costs the
         link. The light value is the same red darkened for a white page (6.4:1 both ways).
         =================================================================================== -->

    <Color x:Key="TokenBrand">#E0452E</Color>
    <Color x:Key="TokenBrandLight">#B5241A</Color>

    <Color x:Key="TokenBrand600">#C1121F</Color>
    <Color x:Key="TokenBrand600Light">#8F1A12</Color>

    <Color x:Key="TokenBrand700">#FF9F7A</Color>
    <Color x:Key="TokenBrand700Light">#7D160F</Color>

    <!-- rgba(224,69,46,.34) — alpha .34 is 0x57. -->
    <Color x:Key="TokenBrand200">#57E0452E</Color>
    <Color x:Key="TokenBrand200Light">#F2CDC7</Color>

    <!-- rgba(224,69,46,.09). Deliberately faint: hover and active tints should whisper on this ramp. -->
    <Color x:Key="TokenBrand050">#17E0452E</Color>
    <Color x:Key="TokenBrand050Light">#FBEEEB</Color>

    <!-- Deeper red for filled badges and CTAs, where white sits directly on it at small sizes
         (5.4:1). app.css declares the same value in both themes; the companion mirrors that. -->
    <Color x:Key="TokenAccent">#C8331D</Color>
    <Color x:Key="TokenAccentLight">#C8331D</Color>

    <!-- The orange end of the hot gradient, named so the glow brushes can reach it. -->
    <Color x:Key="TokenAccentHot">#FF7A3D</Color>
    <Color x:Key="TokenAccentHotLight">#E8752F</Color>

    <!-- ===================================================================================
         STATUS  (app.css tokens: ok, danger, and their 700 / 200 / 050 steps)
         =================================================================================== -->

    <Color x:Key="TokenOk">#35C48A</Color>
    <Color x:Key="TokenOkLight">#1A9D6A</Color>

    <Color x:Key="TokenOk700">#7FE3BB</Color>
    <Color x:Key="TokenOk700Light">#12724C</Color>

    <!-- rgba(53,196,138,.32) — alpha .32 is 0x52. -->
    <Color x:Key="TokenOk200">#5235C48A</Color>
    <Color x:Key="TokenOk200Light">#BFE6D2</Color>

    <!-- rgba(53,196,138,.12) — alpha .12 is 0x1F. -->
    <Color x:Key="TokenOk050">#1F35C48A</Color>
    <Color x:Key="TokenOk050Light">#E6F6EE</Color>

    <Color x:Key="TokenDanger">#F36868</Color>
    <Color x:Key="TokenDangerLight">#D33A3A</Color>

    <Color x:Key="TokenDanger700">#FFB4B4</Color>
    <Color x:Key="TokenDanger700Light">#A12525</Color>

    <!-- rgba(243,104,104,.32). -->
    <Color x:Key="TokenDanger200">#52F36868</Color>
    <Color x:Key="TokenDanger200Light">#F4CCCC</Color>

    <!-- rgba(243,104,104,.12). -->
    <Color x:Key="TokenDanger050">#1FF36868</Color>
    <Color x:Key="TokenDanger050Light">#FDECEC</Color>

    <!-- ===================================================================================
         HERO AND ERROR UI  (app.css tokens: hero-from, hero-to, error-ui-bg, error-ui-ink)

         The hero art is a dark photograph in both themes, which is why these do not follow the
         page down in light mode.
         =================================================================================== -->

    <Color x:Key="TokenHeroFrom">#16161B</Color>
    <Color x:Key="TokenHeroFromLight">#8F1A12</Color>

    <Color x:Key="TokenHeroTo">#4A1119</Color>
    <Color x:Key="TokenHeroToLight">#D4431F</Color>

    <Color x:Key="TokenErrorUiBg">#4A3A12</Color>
    <Color x:Key="TokenErrorUiBgLight">#FFE9A8</Color>

    <Color x:Key="TokenErrorUiInk">#FFE1A0</Color>
    <Color x:Key="TokenErrorUiInkLight">#14161F</Color>

    <!-- ===================================================================================
         STOCK MAUI TEMPLATE KEYS — retuned onto the brand ramp, NOT deleted.

         Styles.xaml pairs these per theme rather than giving each key a light variant, e.g.
         `Light=White, Dark=OffBlack` for a bar background. A key's role therefore depends on
         which side of the pair it sits on, and two of them serve both sides:

           White  = light-theme background AND dark-theme foreground -> must stay near-white
           Black  = light-theme foreground AND dark-theme background -> must stay near-black

         That duality is what makes the port work: the brand's warm off-white (ink, dark) and its
         near-black (bg, dark / ink, light) are close enough to serve both duties.
         =================================================================================== -->

    <!-- Accent for templated controls. Styles.xaml only ever uses Primary on the Light side
         (`Light=Primary, Dark=White`), so this renders in the light theme only. -->
    <Color x:Key="Primary">#E0452E</Color>
    <Color x:Key="PrimaryDark">#FF9F7A</Color>
    <Color x:Key="PrimaryDarkText">#F2F1EF</Color>
    <Color x:Key="Secondary">#1D1D22</Color>
    <Color x:Key="SecondaryDarkText">#C9C8CE</Color>
    <Color x:Key="Tertiary">#C1121F</Color>

    <!-- Warm off-white and near-black, doing double duty as described above. -->
    <Color x:Key="White">#F2F1EF</Color>
    <Color x:Key="Black">#101013</Color>

    <!-- Used for BarTextColor in the light theme; retuned off the template's magenta. -->
    <Color x:Key="Magenta">#B5241A</Color>
    <Color x:Key="MidnightBlue">#16161A</Color>
    <!-- Dark-theme bar background: the surface step, so chrome sits above the page. -->
    <Color x:Key="OffBlack">#17171B</Color>

    <!-- Graphite ramp. Roles, read off how Styles.xaml pairs them:
           Gray100  dark-theme selected indicator          (bright)
           Gray200  light placeholder / dark body text     (light grey, both sides)
           Gray300  light-theme disabled text
           Gray400  light-theme thumb and foreground
           Gray500  dark-theme placeholder
           Gray600  dark-theme disabled text
           Gray900  light-theme body text and titles
           Gray950  light-theme emphasis / dark-theme bar background -->
    <Color x:Key="Gray100">#E6E5E9</Color>
    <Color x:Key="Gray200">#C9C8CE</Color>
    <Color x:Key="Gray300">#A9A8B0</Color>
    <Color x:Key="Gray400">#8E8D97</Color>
    <Color x:Key="Gray500">#6C6B74</Color>
    <Color x:Key="Gray600">#3F3F47</Color>
    <Color x:Key="Gray900">#16161A</Color>
    <Color x:Key="Gray950">#101013</Color>

    <SolidColorBrush x:Key="PrimaryBrush" Color="{StaticResource Primary}"/>
    <SolidColorBrush x:Key="SecondaryBrush" Color="{StaticResource Secondary}"/>
    <SolidColorBrush x:Key="TertiaryBrush" Color="{StaticResource Tertiary}"/>
    <SolidColorBrush x:Key="WhiteBrush" Color="{StaticResource White}"/>
    <SolidColorBrush x:Key="BlackBrush" Color="{StaticResource Black}"/>

    <SolidColorBrush x:Key="Gray100Brush" Color="{StaticResource Gray100}"/>
    <SolidColorBrush x:Key="Gray200Brush" Color="{StaticResource Gray200}"/>
    <SolidColorBrush x:Key="Gray300Brush" Color="{StaticResource Gray300}"/>
    <SolidColorBrush x:Key="Gray400Brush" Color="{StaticResource Gray400}"/>
    <SolidColorBrush x:Key="Gray500Brush" Color="{StaticResource Gray500}"/>
    <SolidColorBrush x:Key="Gray600Brush" Color="{StaticResource Gray600}"/>
    <SolidColorBrush x:Key="Gray900Brush" Color="{StaticResource Gray900}"/>
    <SolidColorBrush x:Key="Gray950Brush" Color="{StaticResource Gray950}"/>
</ResourceDictionary>
