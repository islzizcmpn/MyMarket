<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:PcMarket.Mobile.ViewModels"
             x:Class="PcMarket.Mobile.Views.AccountPage"
             x:DataType="vm:AccountViewModel"
             Title="Account">

    <ScrollView>
        <VerticalStackLayout Padding="16" Spacing="14">

            <Label Text="{Binding Error}" Style="{StaticResource ErrorText}" IsVisible="{Binding HasError}" />

            <!-- Signed out -->
            <Border Style="{StaticResource Card}" IsVisible="{Binding IsAnonymous}">
                <VerticalStackLayout Spacing="10">
                    <Label Text="Sign in" Style="{StaticResource H1}" />
                    <Label Text="Sign in to check out, track orders, and save addresses."
                           Style="{StaticResource MutedText}" />
                    <Button Text="Sign in" Style="{StaticResource PrimaryButton}" Command="{Binding SignInCommand}" />
                    <Button Text="Create an account" Style="{StaticResource GhostButton}" Command="{Binding RegisterCommand}" />
                </VerticalStackLayout>
            </Border>

            <!-- Signed in -->
            <VerticalStackLayout Spacing="14" IsVisible="{Binding IsAuthenticated}">
                <Border Style="{StaticResource Card}">
                    <VerticalStackLayout Spacing="4">
                        <Label Text="{Binding DisplayName}" Style="{StaticResource H1}" />
                        <Label Text="{Binding Profile.Phone}" Style="{StaticResource MutedText}" />
                        <Label Text="{Binding Profile.Email}"
                               Style="{StaticResource MutedText}"
                               IsVisible="{Binding Profile.Email, Converter={StaticResource HasText}}" />
                    </VerticalStackLayout>
                </Border>

                <Button Text="My orders" Style="{StaticResource PrimaryButton}" Command="{Binding OpenOrdersCommand}" />
                <Button Text="Delivery addresses" Style="{StaticResource GhostButton}" Command="{Binding OpenAddressesCommand}" />
                <Button Text="Sign out" Style="{StaticResource GhostButton}" Command="{Binding SignOutCommand}" />
            </VerticalStackLayout>

            <!--
                Appearance. Offered signed in or out, because the choice is about the app rather
                than the account — it is the one setting an anonymous visitor can still make.

                Each segment starts from the Pill style and a DataTrigger fills the selected one
                with the accent gradient. The selected state cannot come from a shared style: it
                depends on the view model, which a ResourceDictionary has no binding context for.
            -->
            <Label Text="Appearance" Style="{StaticResource H3}" Margin="2,6,0,0" />

            <Border Style="{StaticResource Segmented}">
                <Grid ColumnDefinitions="*,*" ColumnSpacing="4">
                    <Button Grid.Column="0"
                            Text="Dark"
                            Style="{StaticResource Pill}"
                            Command="{Binding UseDarkThemeCommand}">
                        <Button.Triggers>
                            <DataTrigger TargetType="Button" Binding="{Binding IsDarkTheme}" Value="True">
                                <Setter Property="Background" Value="{StaticResource BrushAccent}" />
                                <Setter Property="TextColor" Value="{StaticResource White}" />
                                <Setter Property="BorderWidth" Value="0" />
                            </DataTrigger>
                        </Button.Triggers>
                    </Button>

                    <Button Grid.Column="1"
                            Text="Light"
                            Style="{StaticResource Pill}"
                            Command="{Binding UseLightThemeCommand}">
                        <Button.Triggers>
                            <DataTrigger TargetType="Button" Binding="{Binding IsLightTheme}" Value="True">
                                <Setter Property="Background" Value="{StaticResource BrushAccent}" />
                                <Setter Property="TextColor" Value="{StaticResource White}" />
                                <Setter Property="BorderWidth" Value="0" />
                            </DataTrigger>
                        </Button.Triggers>
                    </Button>
                </Grid>
            </Border>

            <ActivityIndicator IsRunning="{Binding IsBusy}" IsVisible="{Binding IsBusy}" />

        </VerticalStackLayout>
    </ScrollView>

</ContentPage>
