<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
	<!--
		networkSecurityConfig allows plain HTTP to the development host only (10.0.2.2 is the emulator's
		route to the machine running the API). Android blocks cleartext by default from API 28, which would
		otherwise make every request from a debug build fail with no useful error.
	-->
	<application android:allowBackup="true" android:icon="@mipmap/appicon" android:roundIcon="@mipmap/appicon_round" android:supportsRtl="true" android:networkSecurityConfig="@xml/network_security_config"></application>
	<uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
	<uses-permission android:name="android.permission.INTERNET" />
	<!-- Required from API 33 to show order-status notifications; requested at runtime. -->
	<uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
</manifest>
