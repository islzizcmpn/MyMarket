<?xml version="1.0" encoding="UTF-8" ?>
<Shell
    x:Class="PcMarket.Mobile.AppShell"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    Title="PcMarket"
    Shell.FlyoutBehavior="Disabled">

    <!--
        Tab content is assigned from code-behind rather than a ContentTemplate so each page comes from
        the DI container with its view model injected.
    -->
    <TabBar>
        <ShellContent x:Name="HomeTab" Title="Home" Route="home" />
        <ShellContent x:Name="CatalogTab" Title="Catalog" Route="catalog" />
        <ShellContent x:Name="CartTab" Title="Cart" Route="cart" />
        <ShellContent x:Name="AccountTab" Title="Account" Route="account" />
    </TabBar>

</Shell>
