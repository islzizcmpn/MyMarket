@{
    var interactive = new InteractiveServerRenderMode(prerender: false);
}
<!DOCTYPE html>
<html lang="@CultureInfo.CurrentUICulture.TwoLetterISOLanguageName">

<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <base href="/" />
    @* Applies the stored theme before the first paint. Must stay inline and ahead of the stylesheet:
       an external file — or waiting for the Blazor circuit — would flash the wrong theme. *@
    <script>
        (function () {
            var KEY = 'pcmarket.theme';

            function current() {
                return document.documentElement.getAttribute('data-theme') === 'light' ? 'light' : 'dark';
            }

            function apply(theme) {
                document.documentElement.setAttribute('data-theme', theme);
                try { localStorage.setItem(KEY, theme); } catch (e) { /* storage blocked */ }
            }

            var stored;
            try { stored = localStorage.getItem(KEY); } catch (e) { /* storage blocked */ }
            apply(stored === 'light' ? 'light' : 'dark');

            window.pcmarketTheme = {
                current: current,
                toggle: function () {
                    var next = current() === 'dark' ? 'light' : 'dark';
                    apply(next);
                    return next;
                }
            };
        })();
    </script>
    <ResourcePreloader />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    @* @@ is a Razor-escaped literal "@" — bare "@400" would be parsed as a code transition. *@
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Play:wght@@400;700&display=swap" />
    @* Arms the scroll reveals before first paint, for the same reason the theme script above is
       inline and early: the hidden state has to be in place before any content renders, or the
       first section would paint visible and then drop out. Loads without defer so the attribute is
       set while the document is still parsing. If this file never arrives, nothing is armed and the
       page simply renders without entrances. *@
    <script src="@Assets["reveal.js"]"></script>
    <link rel="stylesheet" href="@Assets["app.css"]" />
    <link rel="stylesheet" href="@Assets["PcMarket.Web.styles.css"]" />
    <ImportMap />
    <link rel="icon" type="image/png" href="favicon.png" />
    <HeadOutlet @rendermode="interactive" />
</head>

<body>
    <Routes @rendermode="interactive" />
    <script src="@Assets["_framework/blazor.web.js"]"></script>
</body>

</html>
