@* Inline SVG icon set for the shell. Kept in one component so the top bar, floating rail, sidebar
   and footer all draw from the same shapes, and so every icon inherits currentColor and therefore
   follows the theme tokens without a second palette. *@

<svg class="icon @Class" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6"
     stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false">
    @switch (Name)
    {
        case "phone":
            <path d="M6.5 3h3l1.5 4-2 1.5a12 12 0 0 0 5.5 5.5L16 12l4 1.5v3a2 2 0 0 1-2.2 2A16.5 16.5 0 0 1 4.5 5.2 2 2 0 0 1 6.5 3z" />
            break;

        case "clock":
            <circle cx="12" cy="12" r="8.5" />
            <path d="M12 7.5V12l3 1.8" />
            break;

        case "telegram":
            <path d="M20.9 4.2 3.6 10.6c-.8.3-.78 1.45.03 1.73l4.2 1.45 1.6 4.9c.24.73 1.2.9 1.7.3l2.2-2.7 4.3 3.16c.54.4 1.3.1 1.44-.55l2.86-13.4c.15-.72-.55-1.3-1.03-1.09z" />
            <path d="m8 13.6 8.6-5.6-6.5 6.4" />
            break;

        case "mail":
            <rect x="3" y="5" width="18" height="14" rx="2" />
            <path d="m3.6 6.5 8.4 6 8.4-6" />
            break;

        // ---- Payment methods (Phase 14) ----
        case "cash":
            <rect x="2.5" y="6" width="19" height="12" rx="2" />
            <circle cx="12" cy="12" r="2.8" />
            <path d="M6 9.5v5M18 9.5v5" />
            break;

        case "bank":
            <path d="M3.5 9.5 12 4.5l8.5 5" />
            <path d="M5.5 9.5v8M10 9.5v8M14 9.5v8M18.5 9.5v8" />
            <path d="M3 20.5h18" />
            break;

        case "card":
            <rect x="2.5" y="5.5" width="19" height="13" rx="2.2" />
            <path d="M2.5 10h19" />
            <path d="M6 14.5h3.5" />
            break;

        case "instagram":
            <rect x="3.5" y="3.5" width="17" height="17" rx="5" />
            <circle cx="12" cy="12" r="3.8" />
            <circle cx="17" cy="7" r=".9" fill="currentColor" stroke="none" />
            break;

        case "facebook":
            <path d="M13.6 21v-7.6h2.5l.4-2.9h-2.9V8.6c0-.84.24-1.4 1.45-1.4h1.55V4.6a20 20 0 0 0-2.26-.12c-2.24 0-3.77 1.37-3.77 3.88v2.16H8v2.9h2.57V21z" />
            break;

        // ---- Category icons. Matched by slug in CategorySidebar, with "category" as the fallback. ----
        case "computers":
            <rect x="4" y="3.5" width="10" height="17" rx="1.6" />
            <path d="M7 7h4M7 10h4M16.5 12h3.5" />
            break;

        case "laptops":
            <rect x="4" y="5" width="16" height="10.5" rx="1.6" />
            <path d="M2.5 18.5h19" />
            break;

        case "monitors":
            <rect x="3" y="4.5" width="18" height="12" rx="1.6" />
            <path d="M9 20h6M12 16.5V20" />
            break;

        case "memory":
            <rect x="5" y="7" width="14" height="10" rx="1.4" />
            <path d="M8 7V4.5M12 7V4.5M16 7V4.5M8 19.5V17M12 19.5V17M16 19.5V17" />
            break;

        case "mice":
            <rect x="7.5" y="3" width="9" height="18" rx="4.5" />
            <path d="M12 7v3" />
            break;

        case "accessories":
            <path d="M7 4h10l1.5 5.5a6.5 6.5 0 1 1-13 0z" />
            <path d="M10 14.5h4" />
            break;

        case "configurator":
            <path d="M4 6h16M4 12h16M4 18h16" />
            break;

        default:
            <rect x="3.5" y="6" width="17" height="13" rx="1.8" />
            <path d="M3.5 10h17M9 6V3.5h6V6" />
            break;
    }
</svg>

@code {
    [Parameter, EditorRequired] public string Name { get; set; } = string.Empty;

    /// <summary>Extra CSS class, for the size/colour variations the shell needs.</summary>
    [Parameter] public string? Class { get; set; }
}
