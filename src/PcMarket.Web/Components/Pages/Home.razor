@page "/"
@inject CatalogApiClient Catalog
@inject ContentApiClient Content
@inject IStringLocalizer<SharedResource> L
@inject IJSRuntime JS
@inject HomeImages Images

@* Renders inside the Phase 12 storefront shell (MainLayout): top contact bar, main nav, category
   sidebar, footer and floating contact rail wrap this content. *@

<PageTitle>@L["Home.PageTitle"]</PageTitle>

@if (_banners.Count > 0)
{
    <HeroCarousel Banners="_banners" />
}
else
{
    <section class="hero">
        <h1>@L["Home.HeroTitle"]</h1>
        <p>@L["Home.HeroSubtitle"]</p>
        <a class="btn btn--accent" href="/catalog">@L["Home.ShopCatalog"]</a>
    </section>
}

@if (_intro is not null)
{
    <section class="home-intro" data-reveal="block">
        <h2>@_intro.Title</h2>
        <p class="lede">@_intro.Body</p>
    </section>
}

@if (_categories.Count > 0)
{
    @* The rail itself stays put; the circles cascade in one after another. *@
    <nav class="cat-circles" aria-label="@L["Common.Catalog"]" data-reveal="stagger">
        @foreach (var category in _categories)
        {
            <a class="cat-circle" href="@($"/catalog/{category.Slug}")">
                @* The contract carries no artwork, so the ring resolves a local file by slug and
                   keeps the monogram for any category that has neither a file nor a stand-in. *@
                <span class="cat-circle__ring">
                    @if (CategoryArt(category.Slug) is { } art)
                    {
                        <img class="cat-circle__img" src="@art" alt="@category.Name"
                             loading="lazy" decoding="async" />
                    }
                    else
                    {
                        <span class="cat-circle__monogram">@Monogram(category.Name)</span>
                    }
                </span>
                <span class="cat-circle__label">@category.Name</span>
            </a>
        }
    </nav>
}

@if (_loading)
{
    <div class="spinner"></div>
}
else
{
    <ProductCarousel Title="@L["Home.Bestsellers"]" Items="_bestsellers" />
    <ProductCarousel Title="@L["Home.Recommended"]" Items="_recommended" />
}

<FeaturedCarousel />

<section class="home-section home-section--centered">
    <h2 class="home-section__title home-section__title--centered" data-reveal="block">@L["Home.HowWeWork"]</h2>

    <ol class="steps" data-reveal="stagger">
        <li class="step">
            <span class="step__icon" aria-hidden="true">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
                    <path d="M9 11V6a2 2 0 1 1 4 0v5" />
                    <path d="M13 8a2 2 0 1 1 4 0v3" />
                    <path d="M17 10a2 2 0 1 1 4 0v4a7 7 0 0 1-7 7h-2a7 7 0 0 1-7-7v-1a2 2 0 1 1 4 0" />
                </svg>
            </span>
            <h3 class="step__title">@L["Home.Step1Title"]</h3>
            <p class="step__body muted">@L["Home.Step1Body"]</p>
        </li>
        <li class="step">
            <span class="step__icon" aria-hidden="true">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
                    <rect x="2.5" y="6" width="19" height="13" rx="2.5" />
                    <path d="M2.5 10.5h19" />
                    <path d="M6.5 15h4" />
                </svg>
            </span>
            <h3 class="step__title">@L["Home.Step2Title"]</h3>
            <p class="step__body muted">@L["Home.Step2Body"]</p>
        </li>
        <li class="step">
            <span class="step__icon" aria-hidden="true">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
                    <path d="M3 7.5 12 3l9 4.5v9L12 21l-9-4.5z" />
                    <path d="M3 7.5 12 12l9-4.5M12 12v9" />
                </svg>
            </span>
            <h3 class="step__title">@L["Home.Step3Title"]</h3>
            <p class="step__body muted">@L["Home.Step3Body"]</p>
        </li>
    </ol>
</section>

@* Configurator promo. The targets are placeholders until Phase 19 builds /configurator. *@
<section class="build-promo card" data-reveal="block">
    <div class="build-promo__copy">
        <h2 class="build-promo__title">@L["Home.ConfiguratorTitle"]</h2>
        <p class="muted">@L["Home.ConfiguratorSubtitle"]</p>
        <a class="btn btn--accent" href="/configurator">@L["Home.ConfiguratorCta"]</a>
    </div>

    @* Photo when one is on disk, drawn tower when not. *@
    @if (Images.First("promo-pc.jpg", "promo-gaming.jpg", "promo-setup.jpg") is { } promo)
    {
        <div class="build-promo__art build-promo__art--photo">
            <img src="@promo" alt="@L["Home.ConfiguratorImageAlt"]" loading="lazy" decoding="async" />
        </div>
    }
    else
    {
        <div class="build-promo__art" aria-hidden="true">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.2">
                <rect x="4" y="2.5" width="12" height="19" rx="2" />
                <circle cx="10" cy="8" r="2.5" />
                <circle cx="10" cy="15" r="2.5" />
                <path d="M18 6h2a2 2 0 0 1 2 2v8a2 2 0 0 1-2 2h-2" />
            </svg>
        </div>
    }

    <ul class="build-promo__links">
        <li><a href="/configurator?build=intel">@L["Home.ConfiguratorIntel"]</a></li>
        <li><a href="/configurator?build=amd">@L["Home.ConfiguratorAmd"]</a></li>
    </ul>
</section>

<TestimonialsCarousel />

<LogoStrip Title="@L["Home.TrustUs"]" Items="_partners" />
<LogoStrip Title="@L["Home.Brands"]" Items="BrandTiles" />

@code {
    private IReadOnlyList<BannerDto> _banners = [];
    private CmsBlockDto? _intro;
    private IReadOnlyList<CategoryNodeDto> _categories = [];
    private IReadOnlyList<ProductListItemDto> _bestsellers = [];
    private IReadOnlyList<ProductListItemDto> _recommended = [];
    private IReadOnlyList<LogoItem> _brands = [];
    private bool _loading = true;

    /// <summary>
    /// Artwork for a category ring. Prefers cat-{slug}.jpg; where that has not been supplied, a
    /// stand-in from the component photography stands in for it — a case photo reads as "Computers"
    /// perfectly well. Categories with neither keep their monogram.
    /// </summary>
    private static readonly Dictionary<string, string> CategoryFallbackArt = new(StringComparer.OrdinalIgnoreCase)
    {
        ["computers"] = "feat-case-1.jpg",
    };

    private string? CategoryArt(string slug) =>
        CategoryFallbackArt.TryGetValue(slug, out var standIn)
            ? Images.First($"cat-{slug}.jpg", standIn)
            : Images.Path($"cat-{slug}.jpg");

    /// <summary>
    /// "They trust us" — the marks the store actually carries artwork for. This replaced a row of
    /// generic "Partner N" circles; the labels are the real brand names, which double as the alt
    /// text. Anything without a file on disk drops out rather than rendering an empty circle.
    /// </summary>
    private IReadOnlyList<LogoItem> _partners
    {
        get
        {
            List<LogoItem> tiles = [];
            foreach (var (label, fileName) in PartnerArt)
            {
                if (Images.Path(fileName) is { } path)
                {
                    tiles.Add(new LogoItem(label, path));
                }
            }

            return tiles;
        }
    }

    private static readonly (string Label, string FileName)[] PartnerArt =
    [
        ("NVIDIA", "nvidia-logo.webp"),
        ("ASUS", "asus-logo.png"),
        ("MSI", "logo-msi.webp"),
        ("Razer", "razer-logo.png"),
        ("HyperX", "HyperX-Icon.png"),
    ];

    /// <summary>
    /// Brand marks shipped with the storefront. The catalog's own brands come back from the API with
    /// no logo artwork, so the strip would otherwise be a row of monogram circles; these are the
    /// files that were supplied for it. No Href: none of them is a catalog brand, so a filter link
    /// would lead nowhere. Falls back to the API list if none of the files are present.
    /// </summary>
    private IReadOnlyList<LogoItem> BrandTiles
    {
        get
        {
            List<LogoItem> tiles = [];
            Add("MSI", "logo-msi.webp");
            Add("Razer", "razer-logo.png");
            Add("HyperX", "HyperX-Icon.png");
            return tiles.Count > 0 ? tiles : _brands;

            void Add(string label, string fileName)
            {
                if (Images.Path(fileName) is { } path)
                {
                    tiles.Add(new LogoItem(label, path));
                }
            }
        }
    }

    protected override async Task OnInitializedAsync()
    {
        try
        {
            _banners = await Content.GetBannersAsync();
            _intro = await Content.GetBlockAsync("home-intro");
            _categories = await Catalog.GetCategoriesAsync();

            // There is no sales-rank data yet, so both rows are real catalog products under
            // different sorts rather than invented "bestseller" flags. Swap for real ranking
            // once orders can feed it.
            var newest = await Catalog.GetProductsAsync(sort: ProductSort.Newest, page: 1, pageSize: 12);
            var premium = await Catalog.GetProductsAsync(sort: ProductSort.PriceDesc, page: 1, pageSize: 12);
            _bestsellers = premium.Items;
            _recommended = newest.Items;

            var brands = await Catalog.GetBrandsAsync();
            _brands = brands
                .Select(b => new LogoItem(b.Name, b.LogoUrl, $"/catalog?brand={Uri.EscapeDataString(b.Slug)}"))
                .ToList();
        }
        catch
        {
            // Leave defaults; the API may be offline.
        }
        finally
        {
            _loading = false;
        }
    }

    /// <summary>Hands newly rendered sections to the scroll-reveal observer. Runs after every
    /// render, not just the first: the carousels and category rail only exist once the catalog
    /// call above returns, which is a later render than the layout's. The JS side keeps its own
    /// record of what it has already seen, so repeat calls are free.</summary>
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        try
        {
            await JS.InvokeVoidAsync("pcmarketReveal.scan");
        }
        catch
        {
            // Interop unavailable (circuit tearing down) — the sections stay as they are, which is
            // visible: reveal.js only ever hides what it is also about to show.
        }
    }

    private static string Monogram(string name) =>
        string.IsNullOrWhiteSpace(name) ? "?" : name.Trim()[..1].ToUpperInvariant();
}
