<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <IsPackable>false</IsPackable>
    <!--
      These tests host the API in-process (WebApplicationFactory), so this project's runtime config — not
      PcMarket.Api's — decides whether real cultures exist. Without this override the solution-wide
      InvariantGlobalization=true makes the API's request-localization setup throw at startup.
    -->
    <InvariantGlobalization>false</InvariantGlobalization>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="coverlet.collector" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="xunit" />
    <PackageReference Include="xunit.runner.visualstudio" />
    <PackageReference Include="Microsoft.AspNetCore.Mvc.Testing" />
    <PackageReference Include="Testcontainers.PostgreSql" />
    <PackageReference Include="Testcontainers.Redis" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\PcMarket.Api\PcMarket.Api.csproj" />
    <ProjectReference Include="..\..\src\PcMarket.Application\PcMarket.Application.csproj" />
    <ProjectReference Include="..\..\src\PcMarket.Contracts\PcMarket.Contracts.csproj" />
    <ProjectReference Include="..\..\src\PcMarket.Infrastructure\PcMarket.Infrastructure.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

</Project>
