# Production TLS. Copy to `nginx/templates/tls.conf.template` once certificates exist, and edit
# `default.conf.template` so its port-80 `location /` blocks become
#   `return 301 https://$host$request_uri;`
# keeping only the /.well-known/acme-challenge/ location on 80 for renewals.
#
# Issue the certificates first (see docs/runbooks/deploy.md); nginx will not start if it is told to
# load a certificate file that does not exist yet.

server {
    listen 443 ssl;
    http2 on;
    server_name ${STOREFRONT_HOST};

    ssl_certificate     /etc/letsencrypt/live/${STOREFRONT_HOST}/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/${STOREFRONT_HOST}/privkey.pem;
    include /etc/nginx/tls_params.conf;

    location / {
        proxy_pass http://pcmarket_web;
        include /etc/nginx/proxy_params.conf;
    }
}

server {
    listen 443 ssl;
    http2 on;
    server_name ${ADMIN_HOST};

    ssl_certificate     /etc/letsencrypt/live/${ADMIN_HOST}/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/${ADMIN_HOST}/privkey.pem;
    include /etc/nginx/tls_params.conf;

    # The admin panel is a small, known audience. Restricting it by source address is cheap
    # defence-in-depth on top of the role check — uncomment and set your office/VPN ranges.
    # allow 203.0.113.0/24;
    # deny  all;

    location / {
        proxy_pass http://pcmarket_admin;
        include /etc/nginx/proxy_params.conf;
    }
}

server {
    listen 443 ssl;
    http2 on;
    server_name ${API_HOST};

    ssl_certificate     /etc/letsencrypt/live/${API_HOST}/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/${API_HOST}/privkey.pem;
    include /etc/nginx/tls_params.conf;

    location /media/ {
        proxy_pass http://pcmarket_minio/${MINIO_BUCKET}/;
        include /etc/nginx/proxy_params.conf;
        add_header Cache-Control "public, max-age=604800";
    }

    location / {
        proxy_pass http://pcmarket_api;
        include /etc/nginx/proxy_params.conf;
    }
}
